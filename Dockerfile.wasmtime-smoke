FROM rust:1.95-bookworm AS builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends libclang-dev \
  && rm -rf /var/lib/apt/lists/* \
  && rustup target add wasm32-wasip2

WORKDIR /build
COPY native/wasmtime-executor/Cargo.toml native/wasmtime-executor/Cargo.lock native/wasmtime-executor/build.rs ./
COPY native/wasmtime-executor/src ./src
COPY native/wasmtime-executor/wit ./wit
RUN --mount=type=cache,id=pit-cargo-registry,target=/usr/local/cargo/registry \
  --mount=type=cache,id=pit-wasmtime-target,target=/build/target \
  cargo build --release --locked \
  && cp /build/target/release/libpit_wasmtime_executor.so /build/pit_wasmtime_executor.node

COPY native/wasmtime-executor/queued-guest/Cargo.toml native/wasmtime-executor/queued-guest/Cargo.lock /queued-guest/
COPY native/wasmtime-executor/queued-guest/src /queued-guest/src
COPY native/wasmtime-executor/queued-guest/wit /queued-guest/wit
RUN --mount=type=cache,id=pit-cargo-registry,target=/usr/local/cargo/registry \
  --mount=type=cache,id=pit-queued-guest-target,target=/queued-guest/target \
  BINDGEN_EXTRA_CLANG_ARGS="-isystem /usr/lib/llvm-14/lib/clang/14.0.6/include" \
  cargo build --manifest-path /queued-guest/Cargo.toml --target wasm32-wasip2 --release --locked \
  && cp /queued-guest/target/wasm32-wasip2/release/pit_queued_quickjs_guest.wasm /build/pit_queued_quickjs_guest.wasm

FROM node:24-bookworm-slim AS program

WORKDIR /pit
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY native/wasmtime-executor/prepare-smoke.mts ./native/wasmtime-executor/prepare-smoke.mts
RUN npx tsx native/wasmtime-executor/prepare-smoke.mts /prepared-program.json

FROM node:24-bookworm-slim

WORKDIR /smoke
COPY --from=builder /build/pit_wasmtime_executor.node ./pit_wasmtime_executor.node
COPY --from=builder /build/pit_queued_quickjs_guest.wasm ./pit_queued_quickjs_guest.wasm
COPY --from=program /prepared-program.json ./prepared-program.json
COPY native/wasmtime-executor/smoke.cjs ./smoke.cjs

CMD ["node", "smoke.cjs"]
