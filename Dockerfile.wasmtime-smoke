FROM rust:1.95-bookworm AS builder

WORKDIR /build
COPY native/wasmtime-executor/Cargo.toml native/wasmtime-executor/Cargo.lock native/wasmtime-executor/build.rs ./
COPY native/wasmtime-executor/src ./src
RUN cargo build --release --locked

FROM node:24-bookworm-slim

WORKDIR /smoke
COPY --from=builder /build/target/release/libpit_wasmtime_executor.so ./pit_wasmtime_executor.node
COPY native/wasmtime-executor/smoke.cjs ./smoke.cjs

CMD ["node", "smoke.cjs"]
