{
  "name": "pit",
  "version": "0.16.1",
  "description": "A single, capability-injected TypeScript tool for Pi",
  "type": "module",
  "files": [
    "src",
    "native/prebuilds",
    "scripts/install-wasmtime.mjs",
    "prompts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "npm run capabilities:check && npm run structure:check && tsc --noEmit && npm run lint && npm run format:check",
    "capabilities:check": "tsx scripts/generate-capability-contract.ts --check",
    "capabilities:generate": "tsx scripts/generate-capability-contract.ts",
    "structure:check": "node scripts/check-structure.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "quality:audit": "node scripts/audit-code-size.mjs",
    "package:check": "node scripts/verify-package.mjs",
    "wasmtime:build": "docker build -f Dockerfile.wasmtime-smoke --target artifacts --output type=local,dest=native/prebuilds/linux-arm64 .",
    "install": "node scripts/install-wasmtime.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.3",
    "oxfmt": "0.68.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.86.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "1.82.0",
    "tsx": "^4.23.13",
    "typebox": "^1.3.30",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "typescript",
    "sandbox",
    "developer-tools",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cv/pit.git"
  },
  "homepage": "https://github.com/cv/pit#readme",
  "bugs": {
    "url": "https://github.com/cv/pit/issues"
  },
  "packageManager": "npm@11.17.0",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
