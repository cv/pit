{
  "name": "pit",
  "version": "0.2.0",
  "description": "A single, capability-injected TypeScript tool for Pi",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "npm run capabilities:check && tsc --noEmit && biome check . --error-on-warnings --diagnostic-level=warn",
    "capabilities:check": "tsx scripts/generate-capability-contract.ts --check",
    "capabilities:generate": "tsx scripts/generate-capability-contract.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "biome:check": "biome check . --error-on-warnings --diagnostic-level=warn",
    "biome:fix": "biome check --write .",
    "format": "biome format --write .",
    "package:check": "node scripts/verify-package.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "diff": "^9.0.0",
    "esbuild": "^0.25.0",
    "fast-glob": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.20.0",
    "vitest": "^4.1.10",
    "@earendil-works/pi-tui": "^0.83.0",
    "typebox": "^1.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "typescript",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cv/pit.git"
  },
  "homepage": "https://github.com/cv/pit#readme",
  "bugs": {
    "url": "https://github.com/cv/pit/issues"
  },
  "packageManager": "npm@11.6.2",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
