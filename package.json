{
  "name": "pit",
  "version": "0.13.1",
  "description": "A single, capability-injected TypeScript tool for Pi",
  "type": "module",
  "files": [
    "src",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "npm run capabilities:check && tsc --noEmit && npm run lint && npm run format:check",
    "capabilities:check": "tsx scripts/generate-capability-contract.ts --check",
    "capabilities:generate": "tsx scripts/generate-capability-contract.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "quality:audit": "node scripts/audit-code-size.mjs",
    "package:check": "node scripts/verify-package.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.3",
    "oxfmt": "0.62.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "1.77.0",
    "tsx": "^4.20.0",
    "typebox": "^1.0.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "typescript",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cv/pit.git"
  },
  "homepage": "https://github.com/cv/pit#readme",
  "bugs": {
    "url": "https://github.com/cv/pit/issues"
  },
  "packageManager": "npm@11.17.0",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
