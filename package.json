{
  "name": "pit",
  "version": "0.35.0",
  "description": "A single, dependency-injected TypeScript tool for Pi",
  "type": "module",
  "files": [
    "src",
    "prompts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./durable": "./src/durable/index.ts",
    "./package.json": "./package.json"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "npm run globals:check && npm run structure:check && tsc --noEmit && npm run lint && npm run format:check",
    "globals:check": "node --import ./scripts/typescript-resolve.mjs scripts/generate-global-contract.ts --check",
    "globals:generate": "node --import ./scripts/typescript-resolve.mjs scripts/generate-global-contract.ts",
    "structure:check": "node scripts/check-structure.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "quality:audit": "node scripts/audit-code-size.mjs",
    "package:check": "node scripts/verify-package.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "durable": "./src/durable/index.ts",
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.5.0",
    "oxfmt": "0.77.0",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "1.92.0",
    "typebox": "1.3.27",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "typescript",
    "sandbox",
    "developer-tools",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cv/pit.git"
  },
  "homepage": "https://github.com/cv/pit#readme",
  "bugs": {
    "url": "https://github.com/cv/pit/issues"
  },
  "packageManager": "npm@12.2.0",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "typebox": "*",
    "@earendil-works/pi-durable": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-durable": {
      "optional": true
    }
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false
  }
}
