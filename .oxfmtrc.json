{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "embeddedLanguageFormatting": "off",
  "endOfLine": "lf",
  "ignorePatterns": [
    "coverage/**",
    "docs/case_study/session.*",
    "node_modules/**",
    "package-lock.json"
  ],
  "insertFinalNewline": true,
  "jsdoc": false,
  "objectWrap": "preserve",
  "printWidth": 100,
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
